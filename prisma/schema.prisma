generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USERS & PREFERENCES
// ============================================================

model User {
  id            String    @id @default(cuid())
  authId        String    @unique  // Supabase auth.users.id
  email         String    @unique
  firstName     String?
  lastName      String?
  country       String?
  phone         String?   // E.164 format e.g. "+12025551234"
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  preferences      UserPreference?
  applications     Application[]
  jobMatches       UserJobMatch[]
  blockedCompanies UserBlockedCompany[]
  resumes          ResumeVersion[]
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  keywords         String[] // must match at least one
  excludeKeywords  String[] @default([])
  locations        String[] @default([]) // ["Remote", "NYC", "SF"] - empty = any US
  jobTypes         String[] @default([]) // ["full-time", "internship", "contract"]

  // Experience filter (years)
  experienceMin    Int?
  experienceMax    Int?

  // Visa & work auth (2E.1)
  visaSponsorship  Boolean  @default(true)
  stemOptOnly      Boolean  @default(false)
  visaType         String?  // "h1b" | "f1_opt" | "stem_opt" | "green_card" | "citizen" | "other"
  workAuthStatus   String?  // "needs_sponsorship" | "current_h1b" | "ead" | "citizen_or_gc"

  // Compensation & employment (2E.1)
  salaryMin         Int?    // minimum acceptable annual USD
  currentEmployment String? // "employed" | "unemployed" | "student" | "freelance"

  // Targeting (2E.1)
  targetRoles      String[] @default([])  // specific titles user wants
  avoidCompanies   String[] @default([])  // soft block (hard block in UserBlockedCompany)

  dailyApplyLimit  Int      @default(5)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// COMPANIES (which companies to scrape)
// ============================================================

model Company {
  id             String    @id @default(cuid())
  slug           String    @unique // board token: "stripe", "airbnb"
  name           String
  ats            String    // "greenhouse" | "lever" | "ashby" | "workday"
  active         Boolean   @default(true)
  knownToSponsor Boolean?  // null = unknown
  notes          String?

  lastScrapedAt  DateTime?
  lastJobCount   Int       @default(0)
  blockedByUsers UserBlockedCompany[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ats, active])
}

// ============================================================
// SCRAPING RULES (owner-level hard filters)
// ============================================================

model ScrapingRule {
  id          String   @id @default(cuid())
  name        String
  ruleType    String   // "exclude_keyword" | "require_location_match" | "max_age_days"
  pattern     String   // pattern or value
  enabled     Boolean  @default(true)
  appliesTo   String   @default("description") // "description" | "title" | "location" | "any"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// JOBS (shared, deduped)
// ============================================================

model Job {
  id              String   @id @default(cuid())
  source          String
  sourceUrl       String   @unique
  externalId      String?
  title           String
  company         String
  companySlug     String?
  location        String?
  remote          Boolean  @default(false)
  description     String?  @db.Text
  rawJson         Json?
  hash            String?

  // Inferred by AI engine (Phase 2D)
  seniority         String?  // "entry" | "mid" | "senior" | "staff"
  experienceYears   Int?     // best-effort extraction
  skills            String[] @default([])
  sponsorsVisa      Boolean? // null = unknown
  stemOptFriendly   Boolean?
  postedAt          DateTime?
  enrichedAt        DateTime?
  enrichmentVersion String?

  scrapedAt       DateTime  @default(now())
  expiresAt       DateTime?
  deletedAt       DateTime?
  updatedAt       DateTime  @updatedAt

  applications    Application[]
  resumeVersions  ResumeVersion[]
  matches         UserJobMatch[]

  @@index([company])
  @@index([source])
  @@index([hash])
  @@index([scrapedAt])
}

// ============================================================
// USER-JOB MATCH (per-user filtered view)
// ============================================================

model UserJobMatch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore      Float    @default(0)
  scoreBreakdown  Json?
  reason          String?  @db.Text
  matchVersion    String?

  status        String   @default("fresh") // "fresh" | "viewed" | "applied" | "dismissed" | "rejected"
  matchedAt     DateTime @default(now())
  viewedAt      DateTime?
  dismissedAt   DateTime?
  dismissed     Boolean  @default(false)
  autoDismissed Boolean  @default(false)

  @@unique([userId, jobId])
  @@index([userId, matchScore])
  @@index([userId, matchVersion])
  @@index([dismissed])
  @@index([status])
  @@index([matchedAt])
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status       String         @default("draft")
  resumeId     String?
  resume       ResumeVersion? @relation(fields: [resumeId], references: [id])
  appliedAt    DateTime?
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?

  @@index([userId, status])
  @@index([status])
  @@index([archivedAt])
}

// ============================================================
// RESUMES
// ============================================================

model ResumeVersion {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String?
  job          Job?          @relation(fields: [jobId], references: [id])

  isMaster     Boolean       @default(false)
  contentJson  Json          // raw text/structured upload content
  parsedJson   Json?         // AI-extracted: education, work history, skills, etc.
  parsedAt     DateTime?
  parseVersion String?       // e.g. "groq-llama-3.3-70b-resume-v1"
  fileName     String?
  fileSize     Int?

  createdAt    DateTime      @default(now())
  applications Application[]

  @@index([userId])
  @@index([userId, isMaster])
}

// ============================================================
// USER BLOCKED COMPANIES
// ============================================================

model UserBlockedCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason    String?  // "rejected" | "not_interested" | "ghosted" | "low_quality"
  blockedAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

