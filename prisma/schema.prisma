generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USERS & PREFERENCES
// ============================================================

model User {
  id            String    @id @default(cuid())
  authId        String    @unique  // Supabase auth.users.id
  email         String    @unique
  name          String?
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  preferences   UserPreference?
  applications  Application[]
  jobMatches    UserJobMatch[]
  blockedCompanies UserBlockedCompany[]
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  keywords         String[] // must match at least one
  excludeKeywords  String[] @default([])
  locations        String[] @default([]) // ["Remote", "NYC", "SF"] - empty = any US
  jobTypes         String[] @default([]) // ["full-time", "internship", "contract"]

  // Experience filter (years)
  experienceMin    Int?     // Friend C: 0
  experienceMax    Int?     // Friend C: 1
  // Friend A: min=0, max=3 | Friend B: min=7, max=null

  visaSponsorship  Boolean  @default(true) // beta: all friends need sponsorship
  stemOptOnly      Boolean  @default(false)

  dailyApplyLimit  Int      @default(5)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// COMPANIES (which companies to scrape)
// ============================================================

model Company {
  id             String    @id @default(cuid())
  slug           String    @unique // board token: "stripe", "airbnb"
  name           String
  ats            String    // "greenhouse" | "lever" | "ashby" | "workday"
  active         Boolean   @default(true)
  knownToSponsor Boolean?  // null = unknown
  notes          String?

  lastScrapedAt  DateTime?
  lastJobCount   Int       @default(0)
  blockedByUsers UserBlockedCompany[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ats, active])
}

// ============================================================
// SCRAPING RULES (owner-level hard filters)
// ============================================================

model ScrapingRule {
  id          String   @id @default(cuid())
  name        String
  ruleType    String   // "exclude_keyword" | "require_location_match" | "max_age_days"
  pattern     String   // pattern or value
  enabled     Boolean  @default(true)
  appliesTo   String   @default("description") // "description" | "title" | "location" | "any"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// JOBS (shared, deduped)
// ============================================================

model Job {
  id              String   @id @default(cuid())
  source          String
  sourceUrl       String   @unique
  externalId      String?
  title           String
  company         String
  companySlug     String?
  location        String?
  remote          Boolean  @default(false)
  description     String?  @db.Text
  rawJson         Json?
  hash            String?

  // Inferred by AI engine (Phase 4)
  seniority         String?  // "entry" | "mid" | "senior" | "staff"
  experienceYears   Int?     // best-effort extraction
  skills            String[] @default([])
  sponsorsVisa      Boolean? // null = unknown
  stemOptFriendly   Boolean?
  postedAt          DateTime?

  scrapedAt       DateTime @default(now())
  expiresAt   DateTime?
  deletedAt   DateTime?
  updatedAt       DateTime @updatedAt

  applications    Application[]
  resumeVersions  ResumeVersion[]
  matches         UserJobMatch[]

  @@index([company])
  @@index([source])
  @@index([hash])
  @@index([scrapedAt])
}

// ============================================================
// USER-JOB MATCH (per-user filtered view)
// ============================================================

model UserJobMatch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore    Float    @default(0)
  status        String   @default("fresh") // "fresh" | "viewed" | "applied" | "dismissed" | "rejected"
  matchedAt     DateTime @default(now())
  viewedAt      DateTime?
  dismissedAt   DateTime?
  dismissed     Boolean  @default(false)
  autoDismissed Boolean  @default(false)

  @@unique([userId, jobId])
  @@index([userId, matchScore])
  @@index([dismissed])
  @@index([status])
  @@index([matchedAt])
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status       String         @default("draft")
  resumeId     String?
  resume       ResumeVersion? @relation(fields: [resumeId], references: [id])
  appliedAt    DateTime?
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  archivedAt   DateTime?

  @@index([userId, status])
  @@index([status])
  @@index([archivedAt])
}

// ============================================================
// RESUMES
// ============================================================

model ResumeVersion {
  id           String        @id @default(cuid())
  jobId        String?
  job          Job?          @relation(fields: [jobId], references: [id])
  contentJson  Json
  pdfUrl       String?
  docxUrl      String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

// ============================================================
// USER BLOCKED COMPANIES
// ============================================================

model UserBlockedCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reason    String?  // "rejected" | "not_interested" | "ghosted" | "low_quality"
  blockedAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
}

// ============================================================
// LOGS
// ============================================================

model Log {
  id        String   @id @default(cuid())
  action    String
  payload   Json?
  level     String   @default("info")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
