generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Job {
  id            String   @id @default(cuid())
  source        String   // "greenhouse" | "lever" | "ashby" | "workday"
  sourceUrl     String   @unique
  externalId    String?  // ATS job ID
  title         String
  company       String
  location      String?
  remote        Boolean  @default(false)
  description   String?  @db.Text
  rawJson       Json?
  hash          String?  
  scrapedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  applications  Application[]
  resumeVersions ResumeVersion[]

  @@index([company])
  @@index([source])
  @@index([hash])
}

model Application {
  id           String   @id @default(cuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status       String   @default("draft") // draft | reviewing | submitted | rejected | interview | offer
  resumeId     String?
  resume       ResumeVersion? @relation(fields: [resumeId], references: [id])
  appliedAt    DateTime?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model ResumeVersion {
  id           String   @id @default(cuid())
  jobId        String?
  job          Job?     @relation(fields: [jobId], references: [id])
  contentJson  Json
  pdfUrl       String?
  docxUrl      String?
  createdAt    DateTime @default(now())
  applications Application[]
}

model Log {
  id        String   @id @default(cuid())
  action    String   // "scrape" | "dedup" | "ai_score" | "submit" | etc
  payload   Json?
  level     String   @default("info") // info | warn | error
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
